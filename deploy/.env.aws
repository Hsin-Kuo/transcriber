# Canonical .env for AWS production EC2 Web Server (APP_ROLE=server)
#
# 由 deploy-web.sh 首次部署寫入 /opt/transcriber/.env，
# 也由 GitHub Actions (.github/workflows/deploy-aws.yml) 每次 deploy
# 重新 sync 過去，避免 EC2 上 .env 與此檔 drift。
#
# Secret 不放這裡 — 一律從 SSM Parameter Store /transcriber/* 載入。
# 修改後 push → CI 自動套用 → systemctl restart transcriber。

# AWS 部署模式
DEPLOY_ENV=aws
APP_ROLE=server

# AWS 資源
S3_BUCKET=transcriber-files-696637902131
S3_REGION=ap-northeast-1
SQS_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/696637902131/transcriber-tasks
# 優先佇列（pro+enterprise）；空值時所有任務走一般佇列
PRIORITY_SQS_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/696637902131/transcriber-tasks-priority

# Email 設定（使用 Resend）
EMAIL_PROVIDER=resend
FROM_EMAIL=noreply@soundlite.app
FROM_NAME=Soundlite

# 以下密鑰從 SSM Parameter Store 自動載入：
# JWT_SECRET_KEY           / transcriber/jwt-secret
# WORKER_SECRET            / transcriber/worker-secret
# MONGODB_URL              / transcriber/mongodb-url
# RESEND_API_KEY           / transcriber/resend-api-key
# RESEND_WEBHOOK_SECRET    / transcriber/resend-webhook-secret
# GOOGLE_CLIENT_ID         / transcriber/google-client-id
# PAYMENTS91_API_KEY          / transcriber/91app-api-key
# PAYMENTS91_SHARED_SECRET    / transcriber/91app-shared-secret
# PAYMENTS91_PUBLISHABLE_KEY  / transcriber/91app-publishable-key
# PAYMENTS91_STORE_CODE       / transcriber/91app-store-code
# SMILEPAY_GRVC               / transcriber/smilepay-grvc
# SMILEPAY_VERIFY_KEY         / transcriber/smilepay-verify-key

# ⚠️ 91APP 上線 checklist：
#   1. SSM /transcriber/91app-* 四把值換成「正式」憑證
#   2. 在此檔顯式設定 PAYMENTS91_ENV=production（未設時後端 fail-fast 擋下所有金流操作，不會打任何 gateway）
# 金流上線時必須解註解成 production——未解註解時後端 P1-6 fail-fast 會擋下所有金流/
# 發票操作（fail-closed），顯式設成非 production 值會直接擋啟動（main.py validate_payment_env）。
# PAYMENTS91_ENV=production

# ⚠️ SmilePay 電子發票上線 checklist：
#   1. SSM /transcriber/smilepay-* 兩把值換成速買配後台申請的「正式」憑證
#   2. 在此檔顯式設定 SMILEPAY_ENV=production（未設時後端 fail-fast 擋下所有開票操作，不會打測試環境）
# 金流上線時必須解註解成 production——未解註解時後端 P1-6 fail-fast 會擋下所有金流/
# 發票操作（fail-closed），顯式設成非 production 值會直接擋啟動（main.py validate_payment_env）。
# SMILEPAY_ENV=production

# CORS 設定（app=my.soundlite.app；admin=admin.soundlite.app；landing=soundlite.app 過渡期）
CORS_ORIGINS=https://my.soundlite.app,https://admin.soundlite.app,https://soundlite.app

# Frontend URL — email 驗證連結 / 密碼重設 / 91APP 3D return 都用這個組
# 必須指向 transcriber app（my.soundlite.app），不是 landing
FRONTEND_URL=https://my.soundlite.app
