{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StagingSecretsWebOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/jwt-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/mongodb-url",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/worker-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/google-client-id",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/card-token-kek",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/91app-*",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/smilepay-*",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/resend-api-key",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/resend-webhook-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/email-provider",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/from-email",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/google-api-key-1",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/google-api-key-2"
      ]
    },
    {
      "Sid": "DenyAnyOtherParameter",
      "Effect": "Deny",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "NotResource": [
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/jwt-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/mongodb-url",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/worker-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/google-client-id",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/card-token-kek",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/91app-*",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/smilepay-*",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/resend-api-key",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/resend-webhook-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/email-provider",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/from-email",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/google-api-key-1",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber-staging/google-api-key-2",
        "arn:aws:ssm:*:*:parameter/aws/*"
      ]
    },
    {
      "Sid": "StagingBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::transcriber-files-staging-696637902131",
        "arn:aws:s3:::transcriber-files-staging-696637902131/*"
      ]
    },
    {
      "Sid": "StagingQueueSendOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": [
        "arn:aws:sqs:ap-northeast-1:696637902131:transcriber-tasks-staging",
        "arn:aws:sqs:ap-northeast-1:696637902131:transcriber-tasks-staging-priority"
      ]
    }
  ]
}
