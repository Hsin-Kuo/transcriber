{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProdSecretsWebOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/jwt-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/mongodb-url",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/worker-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/google-client-id",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/card-token-kek",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/91app-*",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/smilepay-*",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/resend-api-key",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/resend-webhook-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/email-provider",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/from-email"
      ]
    },
    {
      "Sid": "DenyAnyOtherParameter",
      "Effect": "Deny",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "NotResource": [
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/jwt-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/mongodb-url",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/worker-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/google-client-id",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/card-token-kek",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/91app-*",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/smilepay-*",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/resend-api-key",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/resend-webhook-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/email-provider",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/from-email",
        "arn:aws:ssm:*:*:parameter/aws/*"
      ]
    },
    {
      "Sid": "ProdBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::transcriber-files-696637902131",
        "arn:aws:s3:::transcriber-files-696637902131/*"
      ]
    },
    {
      "Sid": "ProdQueueSendOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": [
        "arn:aws:sqs:ap-northeast-1:696637902131:transcriber-tasks",
        "arn:aws:sqs:ap-northeast-1:696637902131:transcriber-tasks-priority"
      ]
    }
  ]
}
