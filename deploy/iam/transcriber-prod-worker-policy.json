{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProdSecretsWorkerOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/mongodb-url",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/worker-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/google-api-key-1",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/google-api-key-2",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/hf-token"
      ]
    },
    {
      "Sid": "DenyAnyOtherParameter",
      "Effect": "Deny",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "NotResource": [
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/mongodb-url",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/worker-secret",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/google-api-key-1",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/google-api-key-2",
        "arn:aws:ssm:ap-northeast-1:696637902131:parameter/transcriber/hf-token",
        "arn:aws:ssm:*:*:parameter/aws/*"
      ]
    },
    {
      "Sid": "ProdBucketOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::transcriber-files-696637902131",
        "arn:aws:s3:::transcriber-files-696637902131/*"
      ]
    },
    {
      "Sid": "ProdQueueConsumeOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": [
        "arn:aws:sqs:ap-northeast-1:696637902131:transcriber-tasks",
        "arn:aws:sqs:ap-northeast-1:696637902131:transcriber-tasks-priority"
      ]
    },
    {
      "Sid": "SelfStopTaggedOnly",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:ec2:ap-northeast-1:696637902131:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Name": [
            "transcriber-gpu-worker",
            "transcriber-gpu-ondemand"
          ]
        }
      }
    },
    {
      "Sid": "DescribeForSelfIdentify",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    }
  ]
}
